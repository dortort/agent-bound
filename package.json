{
  "name": "agent-bound",
  "version": "0.1.0",
  "description": "Access control framework for MCP servers — inspired by the AgentBound research paper",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-bound": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dortort/agent-bound.git"
  },
  "homepage": "https://github.com/dortort/agent-bound#readme",
  "bugs": {
    "url": "https://github.com/dortort/agent-bound/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "access-control",
    "security",
    "ai-agents",
    "sandboxing",
    "agentbound"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
